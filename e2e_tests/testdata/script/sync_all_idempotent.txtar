# Test that sync --all is idempotent: a second run on an already-synced stack
# leaves every branch tip unchanged.
#
# main:    X
# stack-1:  \ -> 1a
# stack-2:       \ -> 2a

exec git switch main
exec av branch stack-1
commit-file my-file '1a\n' 'Commit 1a'
exec av branch stack-2
commit-file my-file '1a\n2a\n' 'Commit 2a'

# First sync brings the stack up to date.
exec git switch stack-2
exec av sync --all --rebase-to-trunk

# A second sync must not rewrite any branch.
exec sh -c 's1=$(git rev-parse stack-1); s2=$(git rev-parse stack-2); av sync --all --rebase-to-trunk; test "$(git rev-parse stack-1)" = "$s1" -a "$(git rev-parse stack-2)" = "$s2"'
