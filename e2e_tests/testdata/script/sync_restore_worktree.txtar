# Test that sync's final restore-to-trunk is skipped (not fatal) when the
# trunk is already checked out in a sibling worktree.
#
# main:    X -> squash(stack-1)   [checked out in ../wt2]
# stack-1:  \ -> 1a                [merged, then pruned]

exec av branch stack-1
commit-file my-file '1a\n' 'Commit 1a'
exec git push origin stack-1:refs/pull/42/head

# Squash-merge stack-1 into main.
exec git checkout main
exec git merge --squash stack-1
exec git commit --no-edit
exec git push origin main

# Configure mock PR and av metadata (stack-1 merged).
set-branch-pr stack-1 nodeid-42 42 OPEN
mock-pull stack-1 42 MERGED HEAD

# Move main into a sibling worktree so the trunk is checked out elsewhere.
exec git switch stack-1
exec git worktree add ../wt2 main

# Sync and prune. stack-1 is deleted, and the restore falls back to main which
# is checked out in ../wt2 — the checkout must be skipped, not a fatal error.
exec av sync --prune=yes

# stack-1 should be deleted.
! exec git show-ref refs/heads/stack-1

# HEAD should be detached: restoring to main was skipped because main is
# checked out in the sibling worktree.
exec git rev-parse --symbolic-full-name HEAD
stdout '^HEAD$'
